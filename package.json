{
  "name": "hexbusterz",
  "version": "0.1.0",
  "description": "HEXBUSTER Z — a voxel action-FPS roguelite with a buildable hub, procedural bosses and 8-bit death metal.",
  "private": true,
  "type": "module",
  "scripts": {
